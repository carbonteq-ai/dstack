# Serves the fork's dstack-runner / dstack-shim binaries over HTTP so the server
# can install them onto SSH-fleet workers via DSTACK_RUNNER_DOWNLOAD_URL and
# DSTACK_SHIM_DOWNLOAD_URL.
#
# Layout produced (matching the {version}/{arch} download-URL templates):
#   /<VERSION>/binaries/dstack-runner-linux-amd64
#   /<VERSION>/binaries/dstack-shim-linux-amd64

# Optional override. Leave it unset and the build resolves its own version from
# the git metadata in the context, exactly as the server image does — the two
# run the same script over the same context, which is what makes them agree.
ARG VERSION=""

# Digest-pinned, like the server image's base (Dockerfile:13). The tags float,
# and this build produces the runner and shim that every worker downloads and
# executes — with CGO_ENABLED=1 for the shim, so the toolchain and the C library
# behind it are part of the artifact. A moved tag would change the binaries that
# land on the fleet with every pin in this repository unchanged.
FROM golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS version
WORKDIR /version
COPY docker/server/carbonteq/version.sh ./
COPY .git .git
RUN sh version.sh > /release-version && cat /release-version

FROM golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS build
ARG VERSION
ARG TARGETARCH=amd64
COPY --from=version /release-version /release-version
WORKDIR /src
COPY runner/go.mod runner/go.sum ./runner/
WORKDIR /src/runner
RUN go mod download
COPY runner/ ./
# The shim needs cgo; the runner is built fully static so it drops onto any worker.
RUN set -eu; \
    v="${VERSION:-$(cat /release-version)}"; \
    test -n "$v"; \
    GOOS=linux GOARCH=${TARGETARCH} CGO_ENABLED=0 \
        go build -ldflags "-X 'main.Version=${v}' -extldflags '-static'" \
        -o /out/dstack-runner-linux-${TARGETARCH} github.com/dstackai/dstack/runner/cmd/runner; \
    GOOS=linux GOARCH=${TARGETARCH} CGO_ENABLED=1 \
        go build -ldflags "-X 'main.Version=${v}'" \
        -o /out/dstack-shim-linux-${TARGETARCH} github.com/dstackai/dstack/runner/cmd/shim

FROM nginx:alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913
ARG VERSION
COPY --from=version /release-version /release-version
COPY --from=build /out/ /binaries/
# The served path must be the version the server resolves, or every download is a
# 404 and workers silently keep their old binaries. Built here from the same
# resolved value rather than from a separately supplied one.
RUN set -eu; \
    v="${VERSION:-$(cat /release-version)}"; \
    test -n "$v"; \
    mkdir -p "/usr/share/nginx/html/${v}/binaries"; \
    cp /binaries/* "/usr/share/nginx/html/${v}/binaries/"; \
    rm -rf /binaries; \
    chmod -R a+rX /usr/share/nginx/html; \
    echo "serving binaries at /${v}/binaries/"
